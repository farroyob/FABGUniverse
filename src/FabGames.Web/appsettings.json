{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rooms": {
    "MaxRooms": 500,
    "DisconnectGraceSeconds": 60,
    "IdleRoomMinutes": 30,
    "FinishedRoomMinutes": 10,
    "MaxChatLength": 200
  },
  "HubRateLimit": {
    "Burst": 30,
    "RefillPerSecond": 10
  }
}
