<section id="stage-boot" class="stage stage--boot" aria-label="@L["app.name"]" tabindex="-1">
  <div class="boot__bloom"></div>
  <div class="boot__logo">
    <img class="boot__shield" src="~/img/brand/shield.webp" width="575" height="560" alt="">
    <div class="boot__sweep"></div>
  </div>
  <img class="boot__wordmark" src="~/img/brand/wordmark.webp" width="930" height="480" alt="@L["app.name"]">
  <p class="boot__prompt" id="boot-prompt">@L["boot.prompt"]</p>
</section>
