@model HomeViewModel
@{
    ViewData["Title"] = L["app.name"].Value;
    ViewData["View"] = "home";
}
@section Styles {
  <link rel="stylesheet" href="~/css/home/index.css" asp-append-version="true">
}

<main id="main" class="shell">
  <partial name="_Boot" />
  <partial name="_Profiles" />
  <partial name="_Dashboard" model="Model" />
</main>

<partial name="_HomeDialogs" />

@section Scripts {
  <script type="module" src="~/js/home/index.js" asp-append-version="true"></script>
}
